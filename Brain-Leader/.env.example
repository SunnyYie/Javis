# All Brain-Leader settings are prefixed BL_. Never commit the real .env.
# Default model source: ../agents/Knowledge-Assistant/.env (model fields only).
# BL_LLM_ENV_FILE=/absolute/path/to/authorized/.env
# BL_LLM_API_KEY=
# BL_LLM_BASE_URL=
BL_LLM_MODEL=glm-5.3-flashx
BL_LLM_TIMEOUT=120
BL_TOOL_LIMIT=12
BL_LOCAL_ONLY=false
# Optional local inference overrides. Unset preserves each assistant's defaults.
# Embedding default 16; reranker Knowledge default 4, Questions default 8.
# BL_EMBEDDING_BATCH_SIZE=16
# BL_RERANKER_BATCH_SIZE=4
# Exact ordered-input LRU entries per model instance; 0 disables (default 32).
# Cached vectors/scores stay in process memory, never written to shared corpora.
# BL_INFERENCE_CACHE_SIZE=32
# Chinese font is embedded into PDF and DOCX, not assumed available on the reader's computer.
# Auto-detect macOS Heiti SC / Windows SimSun / Linux WenQuanYi.
# Supply a licensed TrueType font if no suitable system font is installed.
# BL_RESUME_FONT_PATH=/absolute/path/chinese.ttf
# BL_RESUME_FONT_INDEX=0
# Isolated runtime and confirmed long-term memory:
# BL_DATA_DIR=/absolute/path/runtime
# BL_MEMORY_DIR=/absolute/path/memory
# For real acceptance use cloned corpora, never the production write namespace:
# BL_KA_DATA_DIR=/absolute/path/isolated/knowledge
# BL_KA_NAMESPACE=blka_unique
# BL_IQB_DATA_DIR=/absolute/path/isolated/questions
# BL_IQB_NAMESPACE=bliqb_unique
