LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=glm-5.3-flashx
RERANK_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3-int8
RERANK_CANDIDATES=40
README_POLICY=canonical
HYBRID_HEAD=1
EVAL_MAX_TOKENS=16384
LLM_TIMEOUT=60
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
MILVUS_URI=http://127.0.0.1:19531
MILVUS_TOKEN=
REDIS_URL=redis://127.0.0.1:16379/0
GITHUB_TOKEN=
GITHUB_IMPORT_MODE=browser
GITHUB_TREE_PAGES=12
TAVILY_API_KEY=
SEARCH_ENDPOINT=https://api.tavily.com/search
BROWSER_ENABLED=true
# Optional explicit path to an existing .env; only LLM_* keys are read.
# LLM_ENV_FILE=/absolute/path/to/model/.env
